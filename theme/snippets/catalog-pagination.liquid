{% if pagination.pages > 1 %}<nav class="catalog-pagination" aria-label="{{ 'catalog.pagination' | t | escape }}">{% assign current_page_text = pagination.current_page | append: '' %}{% for part in pagination.parts %}{% if part.is_link %}<a href="{{ part.url | escape }}" aria-label="{{ 'catalog.page' | t: number: part.title | escape }}">{{ part.title }}</a>{% else %}<span {% if part.title == current_page_text %}aria-current="page"{% endif %}>{{ part.title }}</span>{% endif %}{% endfor %}</nav>{% endif %}
